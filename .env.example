# Copy to .env and fill in real values. Do not commit .env.
#   cp .env.example .env

# --- Auth ---
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=true
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (host processes: uvicorn, workers, alembic) ---
# From todo-api in Docker, Compose overrides this to host.docker.internal
DATABASE_URL=postgresql+psycopg2://todo_user:todo_password@localhost:5432/todo_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_EXPIRE_SECONDS=60

# --- Kafka (host workers use localhost:9092) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true
KAFKA_TOPIC_USERS=todo.users
KAFKA_TOPIC_TASKS=todo.tasks
KAFKA_CONSUMER_GROUP=todo-event-consumer

# --- Outbox publisher ---
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_SECONDS=1.0
OUTBOX_MAX_ATTEMPTS=8

# --- Event consumer ---
KAFKA_COMMIT_EVERY=50
KAFKA_COMMIT_INTERVAL_SEC=1.0